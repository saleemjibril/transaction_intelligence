# PostgreSQL connection string.
# Homebrew Postgres creates a superuser named after your macOS username
# (run `whoami`), with trust auth on 127.0.0.1. Replace USER below.
DATABASE_URL="postgresql://USER@127.0.0.1:5432/sycamore"

JWT_SECRET="change-me-in-production"

# Server
PORT=3000
HOST=0.0.0.0

# Classification provider: rules | mock | deepseek
CLASSIFICATION_PROVIDER=rules

# Only needed when CLASSIFICATION_PROVIDER=deepseek
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"

# Fault-injection behaviour when CLASSIFICATION_PROVIDER=mock:
# ok | fail | rate-limit | invalid
MOCK_BEHAVIOR=ok

# How often the categorisation worker polls for pending transactions (ms)
CATEGORIZATION_POLL_MS=5000

# Retry backoff between classification attempts (ms). The schedule doubles
# each attempt: 30s, 60s, 120s, 240s. Lower it (e.g. 2000) to demonstrate
# the outage and dead-letter path quickly.
CATEGORIZATION_BACKOFF_MS=30000
